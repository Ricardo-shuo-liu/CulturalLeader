# 复制为 .env 后填写。留空 = 自动降级为本地 Mock（不联网也能完整演示）
OPENAI_API_KEY=
# 可指向任意 OpenAI 兼容网关，例如国内中转地址
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini
TTS_MODEL=tts-1
TTS_VOICE=alloy
ASR_MODEL=whisper-1

# MOCK_MODE: auto=有 Key 走真实接口，无 Key 自动 Mock；on=强制 Mock
MOCK_MODE=auto

ADMIN_TOKEN=dev-token
DATABASE_URL=sqlite:///./data/app.db
