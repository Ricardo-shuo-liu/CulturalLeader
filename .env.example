# 复制为 .env 后填写。所有 Key 都只保存在本机 .env（已被 .gitignore 忽略），不会进入 git。

# ── 腾讯位置服务（https://lbs.qq.com/ → 控制台 → key管理） ──
# 【必需】WebServiceAPI Key：服务端用它算真实通勤时长、搜 POI、取行政区划。
# 控制台添加 Key 时勾选「WebServiceAPI」，并把本机出口公网 IP 加进授权白名单
#（在项目里执行 python tools/check_map.py 会直接打印需要填的出口 IP）。
TENCENT_MAP_KEY=
# 【可选】仅当上面这个 Key 开启了「签名校验」时填它的 SK，否则留空
TENCENT_MAP_SK=
# 【可选但强烈建议】浏览器地图 Key：控制台再添加一个 Key，什么都不勾选
#（腾讯官方文档：JavaScript API GL 不需要勾选任何产品，直接创建即可使用）。
# 填了它，城内流程编辑就是可连续拖拽、滚轮缩放、双击放大的真实腾讯底图；
# 没填则自动降级为自建矢量底图（同样可拖拽缩放，只是没有腾讯的瓦片路网）。
TENCENT_MAP_JS_KEY=

# ── 限流与降级 ──
# 每秒最大请求数 / 每日调用上限 / 超限时是否允许用直线估算继续给结果
MAP_QPS=3
MAP_DAILY_LIMIT=5000
ALLOW_ESTIMATE=true

# ── 数字人与后台（留空 = 本地 Mock，不联网也能完整演示） ──
MOCK_MODE=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini

# 语音合成（TTS）——可以单独指向支持 TTS 的服务：
#   DeepSeek / 多数纯对话网关【没有】/v1/audio/speech 接口，配了也不会出声，
#   这时请把 TTS_BASE_URL / TTS_API_KEY 指向 OpenAI、Azure 兼容层或其它 TTS 服务；
#   两者留空则回落到上面的 OPENAI_API_KEY / OPENAI_BASE_URL。
TTS_BASE_URL=
TTS_API_KEY=
# TTS_MODEL: OpenAI 用 tts-1；硅基流动用 FunAudioLLM/CosyVoice2-0.5B
# TTS_VOICE: OpenAI 用 alloy/nova/shimmer；硅基流动用「模型名:音色名」，内置 8 个音色：
#   alex(男 107Hz) · benjamin(男 112Hz) · charles(男 138Hz)
#   anna(女 214Hz) · claire(女 235Hz) · bella(女 255Hz) · diana(女 273Hz) · david(中低 169Hz)
# 试听对比：python tools/tts_voice_samples.py   （样例存到 tests_artifacts/voice-samples/）
TTS_MODEL=tts-1
TTS_VOICE=alloy
# 语音识别（听：按住说话 → 文字）——同样可以单独指向支持 /v1/audio/transcriptions 的服务：
#   硅基流动示例：ASR_BASE_URL=https://api.siliconflow.cn/v1  ASR_MODEL=FunAudioLLM/SenseVoiceSmall
#   留空则回落 OPENAI_API_KEY / OPENAI_BASE_URL（DeepSeek 没有识别接口，Firefox 里按住说话需要用云端识别）
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1

# 没有云端 TTS 时会自动改用浏览器语音；Linux 需要系统装有 speech-dispatcher 或 espeak-ng
ADMIN_TOKEN=dev-token
