# 复制为 .env 后填写。留空 = 自动降级为本地 Mock（不联网也能完整演示）
OPENAI_API_KEY=
# 可指向任意 OpenAI 兼容网关，例如国内中转地址
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini
TTS_MODEL=tts-1
TTS_VOICE=alloy
ASR_MODEL=whisper-1

# MOCK_MODE: auto=有 Key 走真实接口，无 Key 自动 Mock；on=强制 Mock
MOCK_MODE=auto

# 腾讯位置服务（https://lbs.qq.com/ → 控制台 → key管理）
# 【必需】WebServiceAPI 的 Key 填这里：控制台 → 应用管理 → 我的应用 → 添加Key → 勾选「WebServiceAPI」
TENCENT_MAP_KEY=
# 【可选】仅当上面这个 Key 开启了「签名校验」时，把它的 SK 填这里；没开启就留空
TENCENT_MAP_SK=
# 【可选】只有想让城内地图用腾讯底图时才填：控制台再添加一个 Key，什么都不勾选
#（腾讯官方文档：JavaScript API GL 不需要勾选任何产品，直接创建 Key 即可使用）
TENCENT_MAP_JS_KEY=
# 【可选】当 Key 用「域名(Referer)授权」时会报 status=110「此次请求无来源信息」，
# 把白名单里的域名填这里（例如 https://yourdomain.com），后端请求会自动带上 Referer
TENCENT_MAP_REFERER=
# 限流与降级：每秒最大请求数 / 每日调用上限 / 超限时是否允许估算
MAP_QPS=3
MAP_DAILY_LIMIT=5000
ALLOW_ESTIMATE=true

ADMIN_TOKEN=dev-token
DATABASE_URL=sqlite:///./data/app.db
